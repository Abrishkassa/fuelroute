{
  "info": {
    "name": "Fuel Route API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the Django server first (python manage.py runserver). Each request has tests; use the Collection Runner."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "1. Dallas -> Atlanta (first call hits routing API)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"gallons = distance / 10\", () => pm.expect(d.total_gallons).to.be.closeTo(d.distance_miles / 10, 0.1));",
              "pm.test(\"has route geometry + stops + cost\", () => { pm.expect(d.route.geometry.type).to.eql(\"LineString\"); pm.expect(d.fuel_stops).to.be.an(\"array\"); pm.expect(d.total_fuel_cost).to.be.above(0); });",
              "pm.test(\"stops are within tank range of each other\", () => { const m = d.fuel_stops.map(s => s.mile_marker); for (let i = 1; i < m.length; i++) pm.expect(m[i] - m[i-1]).to.be.below(500); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/route/?start=Dallas, TX&finish=Atlanta, GA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Dallas, TX"
            },
            {
              "key": "finish",
              "value": "Atlanta, GA"
            }
          ]
        }
      }
    },
    {
      "name": "2. Same trip again (served from cache)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"gallons = distance / 10\", () => pm.expect(d.total_gallons).to.be.closeTo(d.distance_miles / 10, 0.1));",
