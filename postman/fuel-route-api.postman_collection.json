              "pm.test(\"stops are within tank range of each other\", () => { const m = d.fuel_stops.map(s => s.mile_marker); for (let i = 1; i < m.length; i++) pm.expect(m[i] - m[i-1]).to.be.below(500); });",
              "pm.test(\"fast (cached)\", () => pm.expect(pm.response.responseTime).to.be.below(300));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "",
